# Database. Local uses a file. On Vercel production it reads PROD_DATABASE_URL and a preview reads STAGING_DATABASE_URL, set in the Vercel project.
DATABASE_URL=file:./prisma/db/dev.db
DATABASE_AUTH_TOKEN=

# Session
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Emails: the confirmation code of a new account and the password reset link.
# Without RESEND_API_KEY, in development both are printed in the terminal. In production nobody can register without it.
RESEND_API_KEY=
FROM_EMAIL=
# Optional: sends every email to this address while testing.
RESEND_EMAIL_TEST=

# Password of the demo users created by pnpm db:seed
SEED_PASSWORD=Password@123!

# Remote databases (Turso) to run commands from local. Vercel uses its own DATABASE_URL and DATABASE_AUTH_TOKEN per environment.
STAGING_DATABASE_URL=libsql://name-staging.turso.io
STAGING_DATABASE_AUTH_TOKEN=
PROD_DATABASE_URL=libsql://name-prod.turso.io
PROD_DATABASE_AUTH_TOKEN=

# Video rooms for online practices (LiveKit). `pnpm livekit` starts a local server with these development keys.
# In production use the values of a LiveKit Cloud project.
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-secret-for-practices-not-secret-000

# Seeding a remote database requires TEST_MODE=yes written on purpose.
TEST_MODE=
