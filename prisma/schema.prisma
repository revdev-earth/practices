generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ========================================
// PRACTICES
// ========================================

model Practice {
  id String @id @default(cuid())

  title       String
  description String @default("")

  startsAt DateTime
  endsAt   DateTime

  mode      PracticeMode @default(ONLINE)
  // An online practice can use a room of the video service (lives) instead of an external link. Its address is derived, never stored.
  videoRoom Boolean      @default(false)

  // A public practice can be opened from its shared link by anyone, with no account. A private one needs an account.
  isPublic Boolean @default(false)
  location String  @default("") // Call link or address, depending on the mode

  // Reaching minParticipants confirms the practice.
  // Whoever joins after maxParticipants is filled goes on the waitlist.
  minParticipants Int
  maxParticipants Int

  organizerId String
  organizer   User   @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  signups Signup[]

  // When the host ended the call for everyone. Until then the room stays open past the end while people are in it.
  roomClosedAt DateTime?

  // Present while the host has the people of the call split into groups.
  callGroups CallGroups?

  // The poll this practice came from, when its time was chosen by vote.
  timePoll TimePoll?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([endsAt]) // Split upcoming from past
  @@index([startsAt]) // Read one month for the calendar
  @@index([organizerId])
  @@map("practices")
}

enum PracticeMode {
  ONLINE
  IN_PERSON
}

// ========================================
// TIME POLLS
// ========================================

// A poll to find the best time for a practice. The host proposes times, anyone with the link answers each one,
// and the host posts the practice at the time that works. See src/lib/timePolls.ts.
model TimePoll {
  id String @id @default(cuid())

  title       String
  description String @default("")
  durationMin Int

  // Whether the poll asks for times, or only for days and the host picks the hour when posting.
  kind PollKind @default(TIMES)

  organizerId String
  organizer   User   @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  options TimePollOption[]

  // The practice posted from the poll. Once it exists the poll takes no more answers.
  practiceId String?   @unique
  practice   Practice? @relation(fields: [practiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizerId])
  @@map("time_polls")
}

model TimePollOption {
  id String @id @default(cuid())

  pollId String

  // An exact instant for a poll of times. For a poll of days it is noon UTC of that day, which keeps the days in order.
  startsAt DateTime
  // The calendar day of a poll of days, as "2026-11-26". The same date for everyone, whatever their zone.
  day      String?

  poll  TimePoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes TimePollVote[]

  @@index([pollId])
  @@map("time_poll_options")
}

enum PollKind {
  TIMES
  DAYS
}

enum PollAnswer {
  YES
  IF_NEEDED
  NO
}

// One person's answer to one time. A person is "user:<id>" with an account, or "guest:<uuid>" from a cookie without one.
model TimePollVote {
  id String @id @default(cuid())

  optionId String
  voterKey String
  // Present when the person voted with an account. They are signed up when the practice is posted at a time they said yes to.
  userId   String?
  name     String
  answer   PollAnswer

  option TimePollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([optionId, voterKey])
  @@index([userId])
  @@map("time_poll_votes")
}

// The groups of a video call. Each group talks in a room of its own and group 0 is the main room.
// See src/lib/callGroups.ts.
model CallGroups {
  practiceId String @id

  groupCount  Int
  // JSON with one entry per person of the call: { "<identity>": { "name": "Dana Reyes", "group": 2 } }.
  assignments String

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("call_groups")
}

model Signup {
  id String @id @default(cuid())

  practiceId String
  userId     String

  // Arrival order decides who has a spot and who waits.
  joinedAt DateTime @default(now())

  practice Practice @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([practiceId, userId])
  @@index([userId])
  @@map("signups")
}

// ========================================
// USERS AND SESSION (tables managed by Better Auth)
// ========================================

model User {
  id String @id @default(cuid())

  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  // When the last email confirmation code went out. It limits how often a new one can be requested.
  confirmationCodeSentAt DateTime?

  // The zone of the browser the person last used, from the tz cookie. Emails are built with no browser, so they write times in this zone.
  timeZone String?

  sessions  Session[]
  accounts  Account[]
  practices Practice[]
  signups   Signup[]
  timePolls TimePoll[]
  pollVotes TimePollVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// The password hash lives in the account with providerId "credential".
model Account {
  id         String @id @default(cuid())
  accountId  String
  providerId String
  userId     String

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

// How many times something was tried inside a window of time, such as logging in to one email or asking for a reset link
// from one address. See src/lib/attemptLimits.ts.
model AttemptCounter {
  // Kind and subject, as "login:dana@practices.test".
  key            String   @id
  count          Int
  windowStartsAt DateTime

  @@index([windowStartsAt]) // Drop the old windows
  @@map("attempt_counters")
}

// Temporary tokens, such as the password reset one and the email confirmation code.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}
